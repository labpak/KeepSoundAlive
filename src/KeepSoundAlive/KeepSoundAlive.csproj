<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KeepSoundAlive</RootNamespace>
    <AssemblyName>KeepSoundAlive</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <Version>1.0.0</Version>
    <Product>KeepSoundAlive</Product>
    <Description>Keeps speakers and audio devices awake by playing an inaudible signal.</Description>
    <Copyright>labpak</Copyright>

    <!-- No ICU dependency on Linux; the UI language is detected manually (Strings.DetectSystemLanguage). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- A tray utility: prefer a small memory footprint over GC throughput. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- Single self-contained executable: dotnet publish -c Release -r win-x64 (or linux-x64) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Also as a plain resource, so the CLI can install the Linux menu icon without starting the UI. -->
    <EmbeddedResource Include="Assets\icon.png" LogicalName="icon.png" />
  </ItemGroup>

  <!-- Native libraries are embedded into the exe; their debug symbols are not needed next to it. -->
  <Target Name="RemoveNativeSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_NativeSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_NativeSymbols)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
  </ItemGroup>

</Project>
